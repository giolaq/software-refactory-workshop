  "cards": [
    {
      "dot": "rose",
      "title": "Authority And Trust",
      "items": [
        "The approved Charter outranks profiles, role contracts, adapter output, and CLI choices",
        "Agents propose artifacts or decisions; deterministic validators own lifecycle transitions",
        "Humans approve product intent, final alignment, optional QA tests, and the exact merge revision"
      ]
    },
    {
      "dot": "emerald",
      "title": "Execution And Evidence",
      "items": [
        "Each ticket gets a branch and sibling worktree; this is Git isolation, not a security sandbox",
        "Independent QA proves acceptance tests red, then hashes protect them during implementation",
        "Required gates and read-only code review bind approval to one candidate head"
      ]
    },
    {
      "dot": "cyan",
      "title": "External Crossings",
      "items": [
        "Configured local CLIs call model providers; credentials never pass through the browser",
        "The GitHub backend synchronizes Issues, Project status, claims, pull requests, and reviews",
        "Rehearsal mode substitutes deterministic mock adapters and local tickets for both crossings"
      ]
    }
  ]
