{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,31}$" },
          "path": { "type": "string" },
          "responsibility": { "type": "string" },
          "components": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,31}$" } },
          "notes": { "type": "string" }
        },
        "required": ["id", "path", "responsibility", "components", "notes"]
      }
    },
    "types": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,31}$" },
          "name": { "type": "string" },
          "module": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,31}$" },
          "definition": { "type": "string" },
          "requirements": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,31}$" } },
          "notes": { "type": "string" }
        },
        "required": ["id", "name", "module", "definition", "requirements", "notes"]
      }
    },
    "functions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,31}$" },
          "signature": { "type": "string" },
          "module": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,31}$" },
          "calls": { "type": "array", "items": { "type": "string", "pattern": "^(external:\\S.*|[A-Z][A-Z0-9_-]{0,31})$" } },
          "contracts": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,31}$" } },
          "requirements": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,31}$" } },
          "error_behavior": { "type": "string" },
          "notes": { "type": "string" }
        },
        "required": ["id", "signature", "module", "calls", "contracts", "requirements", "error_behavior", "notes"]
      }
    },
    "call_flows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,31}$" },
          "name": { "type": "string" },
          "steps": { "type": "array", "items": { "type": "string" } },
          "requirements": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,31}$" } }
        },
        "required": ["id", "name", "steps", "requirements"]
      }
    },
    "test_seams": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,31}$" },
          "boundary": { "type": "string" },
          "strategy": { "type": "string" },
          "requirements": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,31}$" } }
        },
        "required": ["id", "boundary", "strategy", "requirements"]
      }
    },
    "blocking_questions": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["modules", "types", "functions", "call_flows", "test_seams", "blocking_questions"]
}
